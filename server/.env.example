# 开发环境使用 SQLite；生产改为 PostgreSQL 连接串即可由 Prisma 无感切换
DATABASE_URL="file:./dev.db"

# 服务端口（前端 Vite 代理 /api → 此端口）
PORT=4000

# JWT 会话密钥（生产环境务必替换为强随机值）
JWT_SECRET="change-me-in-production"

# Kimi API（默认 Key，可被设置页用户级配置覆盖）
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
KIMI_MODEL="kimi-k2.6"

# 用户级 API Key 加密密钥（AES-256-GCM，生产务必替换为强随机值；缺失时回退开发派生密钥）
SETTINGS_ENCRYPTION_KEY="change-me-in-production"